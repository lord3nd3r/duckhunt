{
  "connection": {
    "server": "irc.example.net",
    "port": 6697,
    "nick": "Quackbot",
    "channels": [
      "#duckhunt"
    ],
    "ssl": true,
    "ssl_verify": true,
    "password": "",
    "max_retries": 3,
    "retry_delay": 5,
    "timeout": 30,
    "_comment_send_throttle": "Minimum seconds between outgoing chat lines (PRIVMSG/NOTICE) to avoid server flood limits",
    "send_throttle": 0.3,
    "_comment_reconnect": "Automatic reconnection. After a session that received numeric 001, the next delay is initial_delay. If the TCP connect fails, or the socket drops before registration, the delay doubles up to max_delay.",
    "reconnect": {
      "enabled": true,
      "initial_delay": 5,
      "max_delay": 300
    },
    "_comment_ping": "Lag watchdog: if no server traffic arrives for ping_interval seconds, send a PING; if that goes unanswered for ping_timeout more seconds, the connection is treated as dead and reconnected.",
    "ping_interval": 120,
    "ping_timeout": 60,
    "auto_rejoin": {
      "enabled": true,
      "retry_interval": 20,
      "max_rejoin_attempts": 100
    }
  },
  "sasl": {
    "enabled": false,
    "username": "",
    "password": ""
  },
  "admins": [
    "yourNickHere"
  ],
  "_comment_admins": "A string entry matches the nickname only. Anyone who takes that nick is an admin. Prefer an object with both nick and hostmask. The mask is matched against the full nick!ident@host prefix. Many idents start with ~ (nick!~ident@host). Include the tilde only when it is really there, e.g. {\"nick\": \"yourNickHere\", \"hostmask\": \"*!~ident@trusted.example\"}. *!ident@host does not match !~ident. The tilde is not always present.",
  "commands": {
    "_comment_prefix": "The character(s) that trigger bot commands in-channel and in PM, e.g. '!' for !bang, '@' for @bang, '$' for $bang. Must be non-empty and contain no whitespace.",
    "prefix": "!"
  },
  "duck_spawning": {
    "spawn_min": 1200,
    "spawn_max": 3600,
    "_comment_flock_chance": "Omitted on purpose. When duck_spawning.flock_chance is absent, about 8% of spawns (0.08) are flocks. Set the key only to override that code default.",
    "timeout": 60,
    "rearm_on_duck_shot": true
  },
  "channel_overrides": {
    "_comment": "Per-channel settings. Keys must be lowercase. Only include settings you want to override.",
    "#slow-channel": {
      "duck_spawning": {
        "spawn_min": 3600,
        "spawn_max": 3600
      }
    }
  },
  "duck_types": {
    "normal": {
      "xp": 10,
      "timeout": 60,
      "drop_chance": 0.15
    },
    "golden": {
      "chance": 0.15,
      "min_hp": 3,
      "max_hp": 5,
      "xp": 15,
      "timeout": 60,
      "drop_chance": 0.5
    },
    "fast": {
      "chance": 0.25,
      "timeout": 20,
      "xp": 12,
      "drop_chance": 0.25
    },
    "ninja": {
      "chance": 0.10,
      "dodge_chance": 0.35,
      "xp": 15,
      "timeout": 60,
      "drop_chance": 0.3
    }
  },
  "item_drops": {
    "_comment_fallback": "A non-empty <type>_duck_drops table is that type's loot, together with duck_types.<type>.drop_chance. drop_chance 0 skips ordinary rolls; the check is random > chance, so an exact 0.0 roll would still drop. Flock has no table: each killed member uses normal drop_chance and normal_duck_drops. Any other type without a table does the same. Misses, dodges, befriends, fly-aways, and a golden duck's non-killing hits do not drop. One kill is at most one item, still subject to limits.max_inventory_items.",
    "normal_duck_drops": [
      {"item_id": 1, "weight": 40},
      {"item_id": 2, "weight": 25},
      {"item_id": 4, "weight": 20}
    ],
    "fast_duck_drops": [
      {"item_id": 1, "weight": 30},
      {"item_id": 2, "weight": 25},
      {"item_id": 4, "weight": 20},
      {"item_id": 13, "weight": 15}
    ],
    "ninja_duck_drops": [
      {"item_id": 13, "weight": 30},
      {"item_id": 1, "weight": 30},
      {"item_id": 2, "weight": 20},
      {"item_id": 4, "weight": 20}
    ],
    "golden_duck_drops": [
      {"item_id": 5, "weight": 25},
      {"item_id": 14, "weight": 20},
      {"item_id": 7, "weight": 20},
      {"item_id": 2, "weight": 15},
      {"item_id": 13, "weight": 10},
      {"item_id": 1, "weight": 10}
    ]
  },
  "player_defaults": {
    "accuracy": 75,
    "magazines": 3,
    "bullets_per_magazine": 6,
    "jam_chance": 15,
    "_comment_jam_chance": "Legacy baseline only, not the chance a hunter rolls. New players also store jam_modifier 0. Displayed jam and the bang roll are the level base plus jam_modifier (level 1 is 0%, level 8 is 8%, before brushes). A stored 15 with no jam_modifier migrates to modifier 0. A stored 0 migrates to -15. Using a Gun Brush subtracts 10 from jam_modifier. Using one at 0% effective jam is refused and the item stays in inventory. Do not delete jam_modifier from duckhunt.json.",
    "xp": 0
  },
  "gameplay": {
    "befriend_success_rate": 75,
    "befriend_xp": 5,
    "accuracy_gain_on_hit": 1,
    "accuracy_loss_on_miss": 2,
    "min_accuracy": 10,
    "max_accuracy": 100,
    "min_befriend_success_rate": 5,
    "max_befriend_success_rate": 95,
    "wet_clothes_duration": 300
  },
  "features": {
    "_comment_unused": "shop_enabled, inventory_enabled, and auto_rearm_enabled are not read. Rearm-on-kill is duck_spawning.rearm_on_duck_shot.",
    "shop_enabled": true,
    "inventory_enabled": true,
    "auto_rearm_enabled": true
  },
  "limits": {
    "max_inventory_items": 20,
    "max_per_item_type": 99,
    "max_temp_effects": 20
  },
  "debug": {
    "_comment_enabled": "Whether debug logging is enabled at all (true=debug mode, false=minimal logging)",
    "enabled": true,
    "_comment_log_level": "Overall logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)",
    "log_level": "DEBUG",
    "_comment_console_level": "Console output level - what shows in terminal (DEBUG, INFO, WARNING, ERROR)",
    "console_log_level": "INFO",
    "_comment_file_level": "File logging level - what gets written to log files (DEBUG, INFO, WARNING, ERROR)",
    "file_log_level": "DEBUG",
    "_comment_log_everything": "If true, logs ALL events. If false, logs only important events",
    "log_everything": true,
    "_comment_log_performance": "Whether to enable performance/metrics logging to performance.log",
    "log_performance": true,
    "_comment_unified_format": "If true, console and file logs use same format. If false, console has colors, file is plain",
    "unified_format": true
  }
}
